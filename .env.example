# AgentKit customer API key (ck_live_...) — generate at https://agentkit.best (Customer Dashboard)
AGENTKIT_API_KEY=

# Target environment for the CLI/MCP: staging | production (default: production)
AGENTKIT_ENV=production

# Optional: enable target contract extension endpoints (media library, slug availability)
# AGENTKIT_TARGET_EXTENSIONS=1

# ─── Cloudflare Worker (Streamable HTTP MCP server) ────────────────────────────
# Set the service key as a Wrangler secret, not here: `wrangler secret put AGENTKIT_API_KEY`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OAuth 2.1 Protected Resource (RFC 9728) — authorization server + JWKS
# OAUTH_ISSUER=https://agentkit.best
# OAUTH_JWKS_URL=https://agentkit.best/.well-known/jwks.json
# WORKER_RESOURCE_URL=https://bwak.agentkit.best
